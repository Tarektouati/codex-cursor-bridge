{
  "name": "codex-cursor-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Responses API proxy that lets OpenAI Codex CLI run on Cursor models",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "codex-cursor-bridge": "./src/index.ts"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "gen:catalog": "node --import tsx scripts/gen-catalog.ts",
    "smoke": "node --import tsx scripts/smoke-sdk.ts",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:live": "node --import tsx --test test/live/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.31"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
