# Copy to .env and source it, or export these in your shell before `npm start`.

# Required: your Cursor API key (https://cursor.com/dashboard/integrations).
# Passed straight through to @cursor/sdk.
CURSOR_API_KEY=cursor_...

# Shared secret Codex must present as `Authorization: Bearer`.
# Must match `env_key`'s value in the Codex profile. Required to bind
# off-loopback; optional (but recommended) on 127.0.0.1.
CURSOR_BRIDGE_KEY=change-me

# Optional overrides (defaults shown).
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=4712
# BRIDGE_MODEL=composer-2.5
# BRIDGE_STREAM_THINKING=true
# BRIDGE_TOOL_BATCH_MS=50
# BRIDGE_SESSION_IDLE_MS=1800000
# BRIDGE_SYSTEM_PROMPT=0
# BRIDGE_LOG_LEVEL=info
